{
  "name": "/koris",
  "version": "1.0.1",
  "description": "Autonomous AI agent framework with pluggable channels, skills, persistent memory, and a web dashboard.",
  "main": "dist/src/app.js",
  "bin": {
    "/koris": "dist/src/app.js"
  },
  "files": [
    "dist",
    "dist-web",
    "skills"
  ],
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "validate": "tsx src/validate-settings.ts",
    "onboard": "node dist/src/onboard.js",
    "app": "node dist/src/app.js",
    "clean": "rm -rf dist dist-web",
    "clear:memory": "rm memory/database.*",
    "build": "pnpm run clean && tsc --project tsconfig.json && vite build",
    "build:client": "vite build",
    "dev:client": "vite",
    "lint": "tsc --noEmit -p tsconfig.json",
    "lint:client": "tsc --noEmit -p web/tsconfig.json",
    "lint:website": "tsc --noEmit -p website/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "release": "tsx scripts/release.ts",
    "website:dev": "next dev website",
    "website:build": "next build website",
    "website:preview": "pnpm dlx serve website/out",
    "run": "pnpm app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermesalviano/koris.git"
  },
  "keywords": [],
  "author": "guilhermesalviano",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/guilhermesalviano/koris/issues"
  },
  "homepage": "https://github.com/guilhermesalviano/koris#readme",
  "dependencies": {
    "@guilhermesalviano/telegram-bot": "^0.1.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "ml-distance": "^4.1.0",
    "next": "^16.3.2",
    "p-limit": "^7.3.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "serpapi": "^2.2.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.5"
  }
}
