{
  "name": "/koris",
  "version": "0.1.3",
  "description": "Autonomous AI agent framework with pluggable channels, skills, persistent memory, and a web dashboard.",
  "main": "dist/core/src/app.js",
  "bin": {
    "/koris": "dist/core/src/app.js"
  },
  "files": [
    "dist",
    "dist-web",
    "skills"
  ],
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "validate": "tsx core/src/validate-settings.ts",
    "onboard": "node dist/core/src/onboard.js",
    "app": "node dist/core/src/app.js",
    "clean": "rm -rf dist dist-web",
    "clear:memory": "rm memory/database.*",
    "build": "pnpm run clean && tsc --project tsconfig.json && vite build",
    "build:client": "vite build",
    "build:desktop": "tsc -p apps/desktop/tsconfig.json && cp apps/desktop/loading.html apps/desktop/out/loading.html",
    "dev:client": "vite",
    "desktop": "pnpm build && pnpm build:desktop && electron apps/desktop/out/main.js --no-sandbox",
    "desktop:dev": "pnpm build:desktop && KORIS_DESKTOP_DEV=1 electron apps/desktop/out/main.js --no-sandbox",
    "desktop:stage": "node apps/desktop/scripts/stage-server.mjs && node apps/desktop/scripts/fetch-node.mjs",
    "desktop:package": "pnpm build && pnpm build:desktop && pnpm desktop:stage && node apps/desktop/scripts/package-desktop.mjs",
    "desktop:package:dir": "pnpm build && pnpm build:desktop && pnpm desktop:stage && node apps/desktop/scripts/package-desktop.mjs --dir",
    "lint": "tsc --noEmit -p tsconfig.json",
    "lint:client": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "release": "tsx scripts/release.ts",
    "scaffold:tool": "tsx scripts/scaffold-tool-cli.ts",
    "run": "pnpm app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermesalviano/koris.git"
  },
  "keywords": [],
  "author": "guilhermesalviano",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/guilhermesalviano/koris/issues"
  },
  "homepage": "https://github.com/guilhermesalviano/koris#readme",
  "dependencies": {
    "@guilhermesalviano/telegram-bot": "^0.1.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "ml-distance": "^4.1.0",
    "next": "^16.3.3",
    "p-limit": "^7.3.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "serpapi": "^2.2.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
