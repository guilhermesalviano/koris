# Build output
dist
dist-web
dist-desktop-out
build-resources
apps/desktop/out
next-env.d.ts
*.tsbuildinfo

# Dependencies
node_modules

# Local config & secrets (machine-specific, not shared)
.env
koris.json
settings.json
**/settings.yml
plugins/*/*/config.yml

# Test/build reports & coverage
.testresults
reports/
.stryker-tmp/
coverage/

# Logs
logs/

# Runtime data (writable at runtime; folder kept via .gitkeep)
temp/*
!temp/.gitkeep

core/memory/*
!core/memory/.gitkeep

memory/*
!memory/.gitkeep

.whatsapp_auth

# Tools & skills: only track the current allowlist below. Anything new —
# scaffolded locally or dropped in later (e.g. by a koris-hub sync) — stays
# untracked by default.
plugins/tools/*
!plugins/tools/contracts.ts
!plugins/tools/cron.ts
!plugins/tools/define-tool.ts
!plugins/tools/define-tool.test.ts
!plugins/tools/index.ts
!plugins/tools/runtime.ts
!plugins/tools/runtime.test.ts
!plugins/tools/create-tool/
!plugins/tools/curl-request/
!plugins/tools/delete-beat/
!plugins/tools/list-beats/
!plugins/tools/search-engine/
!plugins/tools/search-engine-restart/
!plugins/tools/set-beat/
!plugins/tools/update-beat/

skills/*
!skills/cat-fact/
