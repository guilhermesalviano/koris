# Build output
dist
dist-web
dist-desktop-out
build-resources
apps/desktop/out
apps/tauri/sidecar/out
apps/tauri/src-tauri/target
apps/tauri/src-tauri/gen
next-env.d.ts
*.tsbuildinfo

# Dependencies
node_modules

# Local config & secrets (machine-specific, not shared)
.env
koris.json
settings.json
**/settings.yml
plugins/*/*/config.yml

# Test/build reports & coverage
.testresults
reports/
.stryker-tmp/
coverage/

# Logs
logs/

# Runtime data (writable at runtime; folder kept via .gitkeep)
temp/*
!temp/.gitkeep

core/memory/*
!core/memory/.gitkeep

memory/*
!memory/.gitkeep

.whatsapp_auth

# Channels, tools & skills: only track the current allowlist below. Anything new —
# scaffolded locally or dropped in later (e.g. by a koris-hub sync) — stays
# untracked by default.
plugins/channels/*
!plugins/channels/channel-config.ts
!plugins/channels/contracts.test.ts
!plugins/channels/contracts.ts
!plugins/channels/index.ts
!plugins/channels/.gitkeep

plugins/tools/*
!plugins/tools/contracts.ts
!plugins/tools/cron.ts
!plugins/tools/define-tool.ts
!plugins/tools/define-tool.test.ts
!plugins/tools/index.ts
!plugins/tools/runtime.ts
!plugins/tools/runtime.test.ts

plugins/skills/*
!plugins/skills/.gitkeep

