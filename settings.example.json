{
  "temp_folder": "./temp",
  "web_port": 3000,
  "timezone": "America/Sao_Paulo",
  "learned_skills_limit": 10,
  "use_default_persona": false,
  "log": {
    "level": "debug"
  },
  "gateway_host": "http://localhost:3000",
  "heartbeat": {
    "enabled": false,
    "active_hours": {
      "start": "08:00",
      "end": "22:00"
    },
    "interval_ms": 1800000
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "use_polling": true,
      "bot_token": "YOUR_BOT_TOKEN",
      "chat_id": "YOUR_CHAT_ID"
    },
    "whatsapp": {
      "enabled": false,
      "whitelist": "NUMBER1,NUMBER2",
      "target_jid": "YOUR_PHONE_NUMBER@s.whatsapp.net",
      "mention_id": "THE_BOT_MENTION_ID",
      "auth_folder": "./.whatsapp_auth"
    }
  },
  "ai": {
    "allow_remote_url": false,
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "api_token": "",
    "model": "gemma4:e4b",
    "embedding": {
      "enabled": true,
      "model": "nomic-embed-text"
    },
    "think_model": "gemma4:26b-a4b-it-q4_K_M",
    "summarizer": {
      "enabled": true
    },
    "timeouts": {
      "idle_ms": 360000,
      "hard_ms": 1200000,
      "health_ms": 5000
    }
  },
  "personal_information": {
    "name": "John Doe",
    "gender": "male",
    "birthday": "1990-01-01",
    "location": "New York, USA",
    "occupation": "Software Engineer"
  }
}
