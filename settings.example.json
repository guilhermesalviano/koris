{
  "temp_folder": "./temp",
  "web_port": 3000,
  "timezone": "America/Sao_Paulo",
  "learned_skills_limit": 10,
  "log": {
    "level": "debug"
  },
  "gateway_host": "http://localhost:3000",
  "allowed_domains": [],
  "heartbeat": {
    "enabled": false,
    "interval_ms": 1800000
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "use_polling": true,
      "bot_token": "YOUR_BOT_TOKEN",
      "chat_id": "YOUR_CHAT_ID"
    },
    "whatsapp": {
      "enabled": false,
      "whitelist": "NUMBER1,NUMBER2",
      "target_jid": "YOUR_PHONE_NUMBER@s.whatsapp.net",
      "mention_id": "THE_BOT_MENTION_ID",
      "auth_folder": "./.whatsapp_auth"
    }
  },
  "ai": {
    "manager": {
      "provider": "ollama",
      "base_url": "http://localhost:11434",
      "api_token": "PROVIDER_API_TOKEN",
      "model": "gemma4:e4b"
    },
    "workers": {
      "provider": "ollama",
      "base_url": "http://localhost:11434",
      "api_token": "PROVIDER_API_TOKEN",
      "model": "qwen:3.5:2b",
      "embedding": true,
      "embed_model": "nomic-embed-text"
    },
    "search_api_key": "SERPAPI_KEY",
    "summarizer": true,
    "prompt_sanitizer": false,
    "timeouts": {
      "idle_ms": 360000,
      "hard_ms": 1200000,
      "health_ms": 5000
    }
  },
  "personal_information": {
    "name": "John Doe",
    "gender": "male",
    "birthday": "1990-01-01",
    "location": "New York, USA",
    "occupation": "Software Engineer"
  }
}

